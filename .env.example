# Supabase (Public — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server-side only — never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini) — for AI summary generation
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude — currently unused in routes but SDK is installed
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Resend — for lead capture emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Resend verified sender email
# Must be a verified domain/email in your Resend dashboard
# For local dev: use onboarding@resend.dev (works without domain verification)
RESEND_FROM_EMAIL=
